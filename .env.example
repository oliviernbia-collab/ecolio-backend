PORT=5000
NODE_ENV=development

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=ecolio
DB_PORT=3306

# Générer une valeur unique avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Ne jamais réutiliser cet exemple tel quel — un secret prévisible permet de forger des tokens valides.
JWT_SECRET=CHANGE_ME_GENERATE_A_RANDOM_64_BYTE_HEX_SECRET
JWT_EXPIRES_IN=7d

FRONTEND_URL=http://localhost:3000

UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# Cloudinary — stockage des images/vidéos uploadées (avatars, photos élèves, logos,
# preuves de paiement). Créer un compte gratuit sur cloudinary.com puis récupérer ces
# 3 valeurs sur console.cloudinary.com (Dashboard → API Keys).
CLOUDINARY_CLOUD_NAME=CHANGE_ME
CLOUDINARY_API_KEY=CHANGE_ME
CLOUDINARY_API_SECRET=CHANGE_ME
